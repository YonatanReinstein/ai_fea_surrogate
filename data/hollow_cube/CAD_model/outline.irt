length = 40.0;
height = 21.0;
width = 1.0;


TV = GBOX(
    point(0,0,0),
    point(0 , 0 , length),
    point(0 , height , 0),
    point(0,height , length),
    point(width, 0 , 0),
    point(width, 0 , length),
    point(width, height , 0),
    point(width, height , length)
);
save("outline.itd", list(TV));
free(TV);
exit();
